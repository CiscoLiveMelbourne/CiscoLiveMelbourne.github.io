meta {
  name: Bulk create users (SCIM 2.0)
  type: http
  seq: 3
}

post {
  url: {{scim_base}}/{{orgid}}/v2/Bulk
  body: json
  auth: inherit
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:api:messages:2.0:BulkRequest"],
    "failOnErrors": 1,
    "operations": [
      {
        "method": "POST",
        "path": "/Users",
        "bulkId": "user-001",
        "data": {
          "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
          "userName": "labuser01@{{test_domain}}",
          "displayName": "Ada Lovelace",
          "name": { "givenName": "Ada", "familyName": "Lovelace" },
          "emails": [{ "value": "labuser01@{{test_domain}}", "type": "work", "primary": true }],
          "active": true
        }
      },
      {
        "method": "POST",
        "path": "/Users",
