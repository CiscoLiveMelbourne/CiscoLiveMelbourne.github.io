meta {
  name: Bulk create users (SCIM 2.0)
  type: http
  seq: 3
}

post {
  url: {{scim_base}}/{{orgid}}/v2/Bulk
  body: json
  auth: inherit
}

script:pre-request {
  // SCIM paths take the organization UUID, the part after ORGANIZATION/ in the decoded org_id.
  const encoded = bru.getEnvVar("org_id") || "";
  const padding = "=".repeat((4 - (encoded.length % 4)) % 4);
  let text = "";
  try {
    text = atob(encoded + padding);
  } catch (error) {
    text = "";
  }
  const marker = "ORGANIZATION/";
  const index = text.indexOf(marker);
  bru.setVar("orgid", index === -1 ? encoded : text.slice(index + marker.length));
}

body:json {
  {
    "schemas": ["urn:ietf:params:scim:api:messages:2.0:BulkRequest"],
    "failOnErrors": 1,
    "operations": [
      {
        "method": "POST",
        "path": "/Users",
        "bulkId": "user-001",
        "data": {
          "schemas": ["urn:ietf:params:scim:schemas:core:2.0:User"],
          "userName": "labuser01@{{test_domain}}",
          "displayName": "Ada Lovelace",
          "name": { "givenName": "Ada", "familyName": "Lovelace" },
          "emails": [{ "value": "labuser01@{{test_domain}}", "type": "work", "primary": true }],
          "active": true
        }
      },
      {
        "method": "POST",
