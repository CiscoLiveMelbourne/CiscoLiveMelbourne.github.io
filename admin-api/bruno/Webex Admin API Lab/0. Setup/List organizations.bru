meta {
  name: List organizations
  type: http
  seq: 2
}

get {
  url: {{base_url}}/organizations
  body: none
  auth: inherit
}

tests {
  test("has an organization", function () {
    expect(res.getBody().items.length).to.be.above(0);
  });

  test("org_id in the Lab environment is this organization", function () {
    const ids = res.getBody().items.map((org) => org.id);
    expect(ids).to.include(bru.getEnvVar("org_id"));
  });
}
