# =============================================================================
# Webex Admin API Lab - environment configuration
# =============================================================================
# Copy this file to ".env" and fill in values for your dCloud reservation.
#   cp .env.example .env
#
# SECURITY: never commit the real .env file. It contains an admin token that
# can read/modify your whole Webex organization. .env is git-ignored already.
# =============================================================================

# Admin access token. For the lab use a Service App access token (preferred)
# or a temporary token from developer.webex.com (12h lifetime, dev only).
WEBEX_ACCESS_TOKEN=

# Your dCloud organization ID (returned by GET /v1/organizations).
# Required for the SCIM (bulk user) exercise.
WEBEX_ORG_ID=

# Base URLs (defaults are correct for commercial Webex - do not change unless
# you are on a dedicated/FedRAMP instance).
WEBEX_API_BASE=https://webexapis.com/v1
WEBEX_SCIM_BASE=https://webexapis.com/identity/scim
